# ---------------------------------------------------------
# Server
# ---------------------------------------------------------
PORT=3000
NODE_ENV=development
# Change this to a long random string in production
SESSION_SECRET=change-this-in-production

# ---------------------------------------------------------
# Database
# DB_DIALECT: mysql | mariadb | postgres | mssql | sqlite
#   mysql/mariadb -> npm install mysql2   (already installed)
#   postgres      -> npm install pg pg-hstore
#   mssql         -> npm install tedious
#   sqlite        -> npm install sqlite3  (already installed, optional)
# ---------------------------------------------------------
DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=project_management
DB_USER=root
DB_PASSWORD=
# Only used when DB_DIALECT=sqlite
DB_STORAGE=./database/dev.sqlite3
# Log SQL queries to the console (true/false)
DB_LOGGING=false

# Same as Django TIME_ZONE = "Asia/Karachi"
DB_TIMEZONE=+05:00
