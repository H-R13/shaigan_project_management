<div class="breadcrumbs">
    <a href="/admin/">Administration</a> /
    <a href="/admin/<%= key %>/"><%= r.plural %></a> /
    <%= obj ? r.display(obj) : 'Add' %>
</div>

<div class="page-header">
    <h1 class="page-title"><%= title %></h1>
    <% if (obj) { %>
        <% if (rperm[key].delete) { %><a href="/admin/<%= key %>/<%= obj.id %>/delete/" class="btn btn-danger">Delete</a><% } %>
    <% } %>
</div>

<div class="section">
    <form method="post" autocomplete="off">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <%- include('../partials/form-fields', { fields, values, errors }) %>
        <div class="btn-row">
            <button type="submit" class="btn btn-primary">Save</button>
            <button type="submit" name="_addanother" value="1" class="btn btn-secondary">Save and add another</button>
            <a href="/admin/<%= key %>/" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>
