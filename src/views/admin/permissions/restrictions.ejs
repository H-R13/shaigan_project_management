<%- include('_tabs') %>

<div class="section">
    <p class="muted-sm perm-help">
        Limit a user to specific records, like ERPNext "User Permissions". Example: restrict a user to
        Project <em>Portal</em> and they only see Portal and the lists, tasks, subtasks and comments inside it,
        even if their role allows more. Users without restrictions are not limited.
    </p>
    <form method="get" class="toolbar">
        <label for="user-pick" class="muted">User</label>
        <select id="user-pick" name="user" onchange="this.form.submit()">
            <option value="">Choose a user…</option>
            <% users.forEach(function (u) { %>
                <option value="<%= u.id %>" <%= selUser && u.id === selUser.id ? 'selected' : '' %>><%= u.username %><%= counts.get(u.id) ? ' (' + counts.get(u.id) + ' restrictions)' : '' %></option>
            <% }) %>
        </select>
        <noscript><button type="submit" class="btn btn-secondary btn-small">Show</button></noscript>
    </form>
</div>

<% if (selUser) { %>
<div class="section">
    <h2 class="section-title"><%= selUser.username %> is limited to</h2>
    <% if (existing.length) { %>
    <div class="table-wrap">
    <table class="data-table">
        <thead><tr><th>Module</th><th>Record</th><th></th></tr></thead>
        <tbody>
        <% existing.forEach(function (r) { %>
            <tr>
                <td><%= r.module %></td>
                <td><%= r.record %></td>
                <td class="text-right">
                    <form method="post" action="/admin/permissions/restrictions/<%= r.id %>/delete/" style="display:inline;">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="link-btn danger">Remove</button>
                    </form>
                </td>
            </tr>
        <% }) %>
        </tbody>
    </table>
    </div>
    <% } else { %>
        <p class="muted">No restrictions — <%= selUser.username %> sees everything their roles allow.</p>
    <% } %>
</div>

<div class="section">
    <h2 class="section-title">Add restriction</h2>
    <form method="get" class="toolbar">
        <input type="hidden" name="user" value="<%= selUser.id %>">
        <label for="module-pick" class="muted">Module</label>
        <select id="module-pick" name="module" onchange="this.form.submit()">
            <% moduleList.forEach(function (m) { %>
                <option value="<%= m.key %>" <%= pickModule && m.key === pickModule.key ? 'selected' : '' %>><%= m.label %></option>
            <% }) %>
        </select>
        <noscript><button type="submit" class="btn btn-secondary btn-small">Show records</button></noscript>
    </form>
    <% if (pickModule) { %>
    <form method="post" action="/admin/permissions/restrictions/">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="user_id" value="<%= selUser.id %>">
        <input type="hidden" name="module" value="<%= pickModule.key %>">
        <% if (records.length) { %>
        <div class="check-list">
            <div class="check-groups">
            <% records.forEach(function (r) { %>
                <label class="check-item"><input type="checkbox" name="record_ids" value="<%= r[0] %>"> <%= r[1] %></label>
            <% }) %>
            </div>
        </div>
        <div class="btn-row" style="margin-top: 14px;">
            <button type="submit" class="btn btn-primary">Limit <%= selUser.username %> to the selected <%= pickModule.label.toLowerCase() %> records</button>
        </div>
        <% } else { %>
            <p class="muted">No <%= pickModule.label.toLowerCase() %> records yet.</p>
        <% } %>
    </form>
    <% } %>
</div>
<% } %>
