<div class="breadcrumbs"><a href="/projects/">Projects</a><% if (project) { %> / <a href="/projects/<%= project.id %>/"><%= project.name %></a><% } %></div>

<div class="page-header">
    <h1 class="page-title" data-popup-title><%= project ? 'Edit project' : 'New project' %></h1>
</div>

<div class="section" data-popup-body>
    <form method="post" action="<%= project ? '/projects/' + project.id + '/edit/' : '/projects/new/' %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <%- include('../../partials/form-fields', { fields, values, errors }) %>
        <div class="btn-row">
            <button type="submit" class="btn btn-primary"><%= project ? 'Save changes' : 'Create project' %></button>
            <a href="<%= project ? '/projects/' + project.id + '/' : '/projects/' %>" class="btn btn-secondary" data-popup-close>Cancel</a>
        </div>
    </form>
</div>
