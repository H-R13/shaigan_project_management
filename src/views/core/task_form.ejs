<div class="breadcrumbs"><a href="/task/<%= task.id %>/"><%= task.title %></a> / Edit</div>

<div class="page-header">
    <h1 class="page-title" data-popup-title>Edit task</h1>
</div>

<div class="section" data-popup-body>
    <form method="post" action="/task/<%= task.id %>/edit/">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <%- include('../partials/form-fields', { fields, values, errors }) %>
        <div class="btn-row">
            <button type="submit" class="btn btn-primary">Save changes</button>
            <a href="/task/<%= task.id %>/" class="btn btn-secondary" data-popup-close>Cancel</a>
        </div>
    </form>
</div>
